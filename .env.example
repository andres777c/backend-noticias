# =====================
# ENTORNO ACTUAL
# =====================
NODE_ENV=development

# =====================
# MONGODB DOCKER
# =====================
MONGO_USER=mongoadmin
MONGO_PASSWORD=secret123
MONGO_DB=noticias_db

# =====================
# CONFIGURACION DESARROLLO
# =====================
PORT_DEV=3000
APP_URL_DEV=http://localhost:3000
MONGODB_DEV=mongodb://mongoadmin:secret123@localhost:27017/noticias_db?authSource=admin
CLIENT_DEV_URL=http://localhost:5173

# =====================
# CONFIGURACION PRODUCCION
# =====================
# PORT_PROD: dejar SIN definir en plataformas que inyectan PORT (Railway, Render,
# Heroku). Si se define, el servidor escucha en un puerto que la plataforma no
# expone y las peticiones nunca llegan.
# PORT_PROD=10000
APP_URL=https://tu-backend.up.railway.app
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/nombre_db?retryWrites=true&w=majority
CLIENT_URL=https://tu-frontend.vercel.app

# =====================
# JWT (OBLIGATORIO - minimo 32 caracteres)
# =====================
JWT_SECRET=tu_jwt_secret_seguro_minimo_32_caracteres_aqui
JWT_EXPIRES_IN=7d

# =====================
# CLOUDINARY (OBLIGATORIO EN PRODUCCION)
# =====================
# Almacenamiento de las imagenes de portada. Se copia del panel de Cloudinary,
# en Settings > API Keys > API Environment variable. El SDK la lee solo.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# =====================
# SUPERADMIN INICIAL (opcional)
# =====================
INIT_SUPERADMIN=false
SUPERADMIN_NAME=Nombre
SUPERADMIN_LASTNAME=Apellido
SUPERADMIN_EMAIL=admin@ejemplo.com
SUPERADMIN_PASSWORD=ContraseñaSegura123!
